  <script>
    function showTab(tabName) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.remove('active');
      });
      document.querySelectorAll('.rule-tab').forEach(btn => {
        btn.classList.remove('active');
      });

      // Show selected tab
      document.getElementById(tabName).classList.add('active');
      document.querySelector(`.rule-tab.${tabName}`).classList.add('active');
    }

    function showLevelDetails(level) {
      const details = {
        1: '🎯 Device Override (Level 1)\n\nHighest priority level. Individual device-specific values always win.\n\nExample: Device #12345 has custom LAN IP = 192.168.50.100\n\nUse case: Site-specific configurations, one-off overrides, troubleshooting',
        2: '🔴 Four-Way Rule - Customer Exception (Level 2)\n\nModel + Carrier + Service Plan + Company\n\nExample: CORD company needs custom firewall rules that override the standard ATM plan rules.\n\nRule: i-22 + ATT + ATM + CORD → fw_acl=[50 custom rules]\n\nThis overrides the Three-Way baseline (Level 4) for CORD devices only.',
        3: '🏢 Company Override (Level 3)\n\nCustomer portfolio-wide setting from Company Layer.\n\nExample: ACME Corp sets DNS = 10.1.1.1 for all their devices\n\nUse case: Customer operational standards, network integration',
        4: '🟣 Three-Way Rule - Service Plan Baseline (Level 4)\n\nModel + Carrier + Service Plan\n\nApplies to ALL customers with matching Model+Carrier+ServicePlan.\n\nExample: All devices with Model i-22 + ATT + ATM get traffic_threshold=350MB\n\nThis is the baseline that Four-Way Rules can override.',
        5: '📋 Service Plan Layer (Level 5)\n\nService plan default value.\n\nExample: ATM plan has data_limit=unlimited\n\nUse case: Service tier differentiation',
        6: '🔵 Two-Way Rule - Model+Carrier (Level 6)\n\nModel + Carrier\n\nExample: Model i-22 + VZW always has advanced=1 enabled\n\nUse case: Carrier-specific features per device model',
        7: '📡 Carrier Layer (Level 7)\n\nCarrier default value.\n\nExample: Verizon has apn=vzwinternet\n\nUse case: Carrier network settings',
        8: '📱 Model Layer (Level 8)\n\nModel default value.\n\nExample: Model i-22 has alarm_io_config=[specific settings]\n\nUse case: Hardware-specific configurations',
        9: '🌐 Global Layer (Level 9)\n\nSystem-wide default value.\n\nExample: dns_primary=8.8.8.8 (applies to all devices unless overridden)\n\nUse case: Infrastructure defaults',
        10: '⚙️ Schema Default (Level 10)\n\nHardcoded default value defined in parameter schema.\n\nExample: reboot_enable=false (schema default)\n\nUse case: Fallback when no layer provides a value',
        11: '⚠️ Required Validation (Level 11)\n\nIf parameter is required and no value found at any level → ERROR\n\nSystem prevents generating invalid configurations.'
      };

      alert(details[level] || 'Level details not found');
    }

    function createRule(ruleType) {
      const messages = {
        'two-way': '➕ Create Two-Way Rule\n\nWizard Steps:\n1. Select parameter\n2. Select Model\n3. Select Carrier\n4. Set value\n5. Preview affected devices\n6. Save\n\n(In production, this would open the rule creation wizard)',
        'three-way': '➕ Create Three-Way Rule\n\nWizard Steps:\n1. Select parameter\n2. Select Model\n3. Select Carrier\n4. Select Service Plan\n5. Set baseline value (applies to ALL customers)\n6. Preview affected devices\n7. Save\n\n(In production, this would open the rule creation wizard)',
        'four-way': '➕ Create Four-Way Rule (Customer Exception)\n\nWizard Steps:\n1. Select parameter\n2. Select Model\n3. Select Carrier\n4. Select Service Plan\n5. Select Company (REQUIRED)\n6. Set exception value (overrides baseline for this customer)\n7. System validates Three-Way baseline exists\n8. Preview affected devices\n9. Save\n\n⚠️ Note: Create Three-Way Rule baseline first, then add Four-Way exceptions for customers needing different values.\n\n(In production, this would open the rule creation wizard)'
      };

      alert(messages[ruleType] || 'Create rule wizard would open here');
    }

    function showMatrixDetails(model, carrier, plan) {
      alert(`📊 Coverage Details\n\nModel: ${model}\nCarrier: ${carrier}\nService Plan: ${plan}\n\nClick to view:\n• All rules for this combination\n• Affected devices count\n• Customer exceptions (if any)\n• Edit or delete rules\n\n(In production, this would show detailed rule management for this combination)`);
    }
  </script>
